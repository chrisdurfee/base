{
	"name": "@base-framework/base",
	"version": "4.0.0",
	"description": "This is a javascript framework.",
	"main": "./dist/base.js",
	"module": "./dist/base.js",
	"type": "module",
	"sideEffects": [
		"./dist/base.js",
		"./dist/modules/ajax.js",
		"./dist/modules/component.js",
		"./dist/modules/router.js"
	],
	"scripts": {
		"build": "node ./esbuild.js && tsc",
		"prepublishOnly": "npm run build",
		"test": "vitest",
		"test:run": "vitest run",
		"size": "node ./scripts/size-report.js",
		"size:check": "node ./scripts/size-report.js --check",
		"cache:check": "node ./scripts/chunk-stability.js",
		"bench": "node --expose-gc ./scripts/bench.js"
	},
	"keywords": [
		"JavaScript",
		"Framework",
		"Base",
		"ES6"
	],
	"author": "Chris Durfee",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chrisdurfee/base.git"
	},
	"bugs": {
		"url": "https://github.com/chrisdurfee/base/issues"
	},
	"devDependencies": {
		"esbuild": "^0.25.0",
		"jsdom": "^29.1.1",
		"typescript": "^5.7.3",
		"vitest": "^4.1.11"
	},
	"types": "dist/types/base.d.ts",
	"files": [
		"package.json",
		"readme.md",
		"dist",
		"copilot.md",
		"!dist/**/*.map",
		"!dist/meta.json"
	],
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/types/base.d.ts",
			"import": "./dist/base.js",
			"require": "./dist/base.js"
		},
		"./component": {
			"types": "./dist/types/entries/component.d.ts",
			"import": "./dist/modules/component.js"
		},
		"./data": {
			"types": "./dist/types/entries/data.d.ts",
			"import": "./dist/modules/data.js"
		},
		"./router": {
			"types": "./dist/types/entries/router.d.ts",
			"import": "./dist/modules/router.js"
		},
		"./state": {
			"types": "./dist/types/entries/state.d.ts",
			"import": "./dist/modules/state.js"
		},
		"./ajax": {
			"types": "./dist/types/entries/ajax.d.ts",
			"import": "./dist/modules/ajax.js"
		},
		"./html": {
			"types": "./dist/types/entries/html.d.ts",
			"import": "./dist/modules/html.js"
		},
		"./date": {
			"types": "./dist/types/entries/date.d.ts",
			"import": "./dist/modules/date.js"
		}
	},
	"homepage": "https://github.com/chrisdurfee/base#readme"
}
